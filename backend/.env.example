# Copy to backend/.env and fill in. Never commit the real .env.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_NAME=ai_resume_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5433

CELERY_BROKER_URL=redis://localhost:6379/0

# LLM: any OpenAI-compatible API. Local Ollama by default; for Groq use
# LLM_BASE_URL=https://api.groq.com/openai/v1 and set LLM_API_KEY.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b

# Free key from https://jooble.org/api/about (500-request default quota)
JOOBLE_API_KEY=

MAX_RESUME_BYTES=5242880
