# Copy to .env (next to docker-compose.yml) and fill in. Never commit the real .env.

# Your domain, e.g. resume.example.com or myname.duckdns.org, pointed at the VM's IP.
DOMAIN=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

DB_NAME=ai_resume_db
DB_USER=postgres
DB_PASSWORD=

OLLAMA_MODEL=qwen2.5:7b
# CPU inference is slow; a big batch can take several minutes.
OLLAMA_TIMEOUT=900

# Free key from https://jooble.org/api/about. Without it, only Remotive is fetched.
JOOBLE_API_KEY=
